# ── WebView2 运行时数据（缓存 / Cookie / 用户数据，首次运行自动生成，70MB+） ──
.webview2/

# ── 调试与测试临时产物（排障时脚本一律以 _ 前缀命名） ──
_*.log
_*.err
_*.out
_*.bmp
_*.tmp
_*.ahk
_*.txt
_*.png
_*.js

# ── 页面报错时会写的日志（排障用，不提交） ──
launcher.log

# ── 使用记录（每台机器各不相同，跟着使用习惯走，不进仓库） ──
usage.json
usage.json.tmp

# ── 拉取在线配置时自动留的备份（本机状态，不进仓库） ──
config.json.bak

# ── 生成拼音表用的原始数据（985KB，只在重新生成时需要） ──
pinyin.txt

# ── AutoHotkey 官方帮助文档（2MB，非运行必需，需要时从官网取） ──
runtime/AutoHotkey.chm

# ── 系统与编辑器噪音 ──
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
